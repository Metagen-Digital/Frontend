# Site
NUXT_PUBLIC_SITE_URL=https://metagendigital.com
NUXT_PUBLIC_API_BASE=https://api.metagendigital.com/api
COOKIE_DOMAIN=

# Analytics & Ads (all public — these ship in the browser, none are secrets)
# GA4 Measurement ID. Falls back to the site's own ID when unset.
NUXT_PUBLIC_GTAG_ID=
# Meta Pixel ID from business.facebook.com/events_manager (15–16 digits).
# Leave empty in dev/preview: the pixel then never loads and ad reporting stays clean.
NUXT_PUBLIC_FB_PIXEL_ID=

# Search engine / platform verification tokens (HTML-meta method)
# Google Search Console — search.google.com/search-console
NUXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools — bing.com/webmasters (also backs DuckDuckGo + ChatGPT search)
NUXT_PUBLIC_BING_VERIFICATION=
# Meta domain verification — Events Manager → Brand Safety → Domains.
# Required for iOS 14+ Aggregated Event Measurement (Lead/Purchase optimisation).
NUXT_PUBLIC_FB_DOMAIN_VERIFICATION=
